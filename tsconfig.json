{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@cookids/server/*": [
        "./packages/server/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "packages/**/*.ts",
  ],
  "exclude": [
    "packages/*/node_modules"
  ]
}
